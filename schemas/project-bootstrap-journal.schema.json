{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-bootstrap-journal.schema.json",
  "title": "Agentic SDLC Project Bootstrap Journal v1",
  "description": "Hash-bound recovery journal written before bootstrap mutations and completed only after the exact manifest is durable.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "version",
    "status",
    "request",
    "request_hash",
    "prepared_manifest",
    "completed_manifest_ref",
    "previous_journal_hash",
    "created_at",
    "updated_at",
    "hash_algorithm",
    "journal_hash"
  ],
  "properties": {
    "kind": { "const": "project_bootstrap_journal" },
    "schema_version": { "const": "project-bootstrap-journal:v1" },
    "version": { "const": 1 },
    "status": {
      "enum": [
        "prepared",
        "manifest_ready",
        "completed"
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "initial_project_identity_sha256",
        "plugin_version",
        "config_sha256",
        "phase_order",
        "kb_directories"
      ],
      "properties": {
        "initial_project_identity_sha256": {
          "description": "Stable-JSON SHA-256 of the exact initial project_id and project_name. Their clear values are deliberately excluded from the immutable recovery journal.",
          "$ref": "#/$defs/sha256"
        },
        "plugin_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "phase_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "kb_directories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "request_hash": { "$ref": "#/$defs/sha256" },
    "prepared_manifest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "project-bootstrap-manifest.schema.json" }
      ]
    },
    "completed_manifest_ref": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "path",
            "schema_version",
            "manifest_hash",
            "hash_algorithm"
          ],
          "properties": {
            "path": { "const": ".sdlc/bootstrap-manifest.json" },
            "schema_version": { "const": "project-bootstrap-manifest:v1" },
            "manifest_hash": {
              "description": "The manifest's sha256:stable-json:v1 self-hash, not a digest of the manifest file bytes.",
              "$ref": "#/$defs/sha256"
            },
            "hash_algorithm": { "const": "sha256:stable-json:v1" }
          },
          "additionalProperties": false
        }
      ]
    },
    "previous_journal_hash": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "hash_algorithm": { "const": "sha256:stable-json:v1" },
    "journal_hash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "prepared" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "prepared_manifest": { "type": "null" },
          "completed_manifest_ref": { "type": "null" },
          "previous_journal_hash": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "manifest_ready" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "prepared_manifest": {
            "$ref": "project-bootstrap-manifest.schema.json"
          },
          "completed_manifest_ref": { "type": "null" },
          "previous_journal_hash": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "prepared_manifest": {
            "$ref": "project-bootstrap-manifest.schema.json"
          },
          "completed_manifest_ref": {
            "type": "object",
            "required": [
              "path",
              "schema_version",
              "manifest_hash",
              "hash_algorithm"
            ]
          },
          "previous_journal_hash": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
