{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metering-snapshot.schema.json",
  "title": "Provider-neutral advisory metering snapshot v1",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "version",
    "id",
    "adapter",
    "scope",
    "captured_at",
    "cumulative",
    "metering",
    "assurance",
    "source",
    "snapshot_hash",
    "hash_algorithm"
  ],
  "properties": {
    "kind": { "const": "metering_snapshot" },
    "schema_version": { "const": "metering-snapshot:v1" },
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "adapter": { "$ref": "#/$defs/adapter" },
    "scope": { "$ref": "#/$defs/scope" },
    "captured_at": { "type": "string", "format": "date-time" },
    "cumulative": { "$ref": "#/$defs/cumulative" },
    "metering": { "$ref": "#/$defs/metering" },
    "assurance": { "$ref": "#/$defs/assurance" },
    "source": { "$ref": "#/$defs/source" },
    "snapshot_hash": { "$ref": "#/$defs/sha256" },
    "hash_algorithm": { "const": "sha256:stable-json:v1" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decimal": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
    "counter": { "type": "integer", "minimum": 0 },
    "adapter": {
      "oneOf": [
        { "$ref": "#/$defs/codeburn_adapter" },
        { "$ref": "#/$defs/codex_session_adapter" }
      ]
    },
    "codeburn_adapter": {
      "type": "object",
      "required": ["id", "version", "report_contract"],
      "properties": {
        "id": { "const": "codeburn" },
        "version": { "type": "string", "pattern": "^0\\.9\\.[0-9]+$" },
        "report_contract": { "const": "codeburn-report:v0.9.x" }
      },
      "additionalProperties": false
    },
    "codex_session_adapter": {
      "type": "object",
      "required": ["id", "version", "report_contract"],
      "properties": {
        "id": { "const": "codex-session" },
        "version": { "const": "1.0.0" },
        "report_contract": { "const": "codex-session-token-count:v1" }
      },
      "additionalProperties": false
    },
    "scope": {
      "oneOf": [
        { "$ref": "#/$defs/codeburn_scope" },
        { "$ref": "#/$defs/codex_session_scope" }
      ]
    },
    "codeburn_scope": {
      "type": "object",
      "required": ["provider", "project", "from", "to"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "project": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "format": "date" },
        "to": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "codex_session_scope": {
      "type": "object",
      "required": ["thread_id"],
      "properties": {
        "thread_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "oneOf": [
        { "$ref": "#/$defs/codeburn_tokens" },
        { "$ref": "#/$defs/codex_session_tokens" }
      ]
    },
    "codeburn_tokens": {
      "type": "object",
      "required": ["input", "output", "cache_read", "cache_write"],
      "properties": {
        "input": { "$ref": "#/$defs/counter" },
        "output": { "$ref": "#/$defs/counter" },
        "cache_read": { "$ref": "#/$defs/counter" },
        "cache_write": { "$ref": "#/$defs/counter" }
      },
      "additionalProperties": false
    },
    "codex_session_tokens": {
      "type": "object",
      "required": [
        "total",
        "input",
        "output",
        "cache_read",
        "cache_write",
        "reasoning_output"
      ],
      "properties": {
        "total": { "$ref": "#/$defs/counter" },
        "input": { "$ref": "#/$defs/counter" },
        "output": { "$ref": "#/$defs/counter" },
        "cache_read": { "$ref": "#/$defs/counter" },
        "cache_write": { "$ref": "#/$defs/counter" },
        "reasoning_output": { "$ref": "#/$defs/counter" }
      },
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "$ref": "#/$defs/decimal" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "additionalProperties": false
    },
    "cumulative": {
      "type": "object",
      "required": ["tokens", "calls", "sessions", "cost"],
      "properties": {
        "tokens": { "$ref": "#/$defs/tokens" },
        "calls": { "$ref": "#/$defs/counter" },
        "sessions": { "$ref": "#/$defs/counter" },
        "cost": { "$ref": "#/$defs/money" }
      },
      "additionalProperties": false
    },
    "metering": {
      "type": "object",
      "required": ["tokens", "calls", "cost"],
      "properties": {
        "tokens": { "const": "estimated" },
        "calls": { "const": "estimated" },
        "cost": { "enum": ["estimated", "unavailable"] }
      },
      "additionalProperties": false
    },
    "assurance": {
      "type": "object",
      "required": ["classification", "enforcement", "trusted_exact", "metrics", "reasons"],
      "properties": {
        "classification": { "const": "advisory_observed" },
        "enforcement": { "const": "advisory" },
        "trusted_exact": { "const": false },
        "metrics": { "$ref": "#/$defs/metering" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "project_match": {
      "type": "object",
      "required": ["name", "path", "calls", "cost"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "calls": { "$ref": "#/$defs/counter" },
        "cost": { "$ref": "#/$defs/money" }
      },
      "additionalProperties": false
    },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/codeburn_source" },
        { "$ref": "#/$defs/codex_session_source" }
      ]
    },
    "codeburn_source": {
      "type": "object",
      "required": ["argv", "report_hash", "report_generated_at", "report_period", "matched_projects"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": { "type": "string" }
        },
        "report_hash": { "$ref": "#/$defs/sha256" },
        "report_generated_at": { "type": "string", "format": "date-time" },
        "report_period": { "type": "string", "minLength": 1 },
        "matched_projects": {
          "type": "array",
          "items": { "$ref": "#/$defs/project_match" }
        }
      },
      "additionalProperties": false
    },
    "codex_session_source": {
      "type": "object",
      "required": [
        "session_id",
        "session_identity_hash",
        "project_scope_hash",
        "relative_path",
        "file_size_bytes",
        "event_timestamp",
        "event_hash",
        "rate_limits",
        "shell",
        "authentication_required"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "session_identity_hash": { "$ref": "#/$defs/sha256" },
        "project_scope_hash": { "$ref": "#/$defs/sha256" },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "not": { "pattern": "^(?:/|\\.\\./)" }
        },
        "file_size_bytes": { "$ref": "#/$defs/counter" },
        "event_timestamp": { "type": "string", "format": "date-time" },
        "event_hash": { "$ref": "#/$defs/sha256" },
        "rate_limits": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/codex_rate_limits" }
          ]
        },
        "shell": { "const": false },
        "authentication_required": { "const": false }
      },
      "additionalProperties": false
    },
    "codex_rate_limit_window": {
      "type": "object",
      "required": ["used_percent", "window_minutes", "resets_at"],
      "properties": {
        "used_percent": { "type": ["number", "null"] },
        "window_minutes": {
          "oneOf": [
            { "$ref": "#/$defs/counter" },
            { "type": "null" }
          ]
        },
        "resets_at": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "codex_rate_limits": {
      "type": "object",
      "required": [
        "limit_id",
        "primary",
        "secondary",
        "credits",
        "spend_control_reached",
        "rate_limit_reached_type"
      ],
      "properties": {
        "limit_id": { "type": ["string", "null"] },
        "primary": {
          "oneOf": [
            { "$ref": "#/$defs/codex_rate_limit_window" },
            { "type": "null" }
          ]
        },
        "secondary": {
          "oneOf": [
            { "$ref": "#/$defs/codex_rate_limit_window" },
            { "type": "null" }
          ]
        },
        "credits": {
          "oneOf": [
            {
              "type": "object",
              "required": ["has_credits", "unlimited", "balance"],
              "properties": {
                "has_credits": { "type": ["boolean", "null"] },
                "unlimited": { "type": ["boolean", "null"] },
                "balance": { "type": ["number", "null"] }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "spend_control_reached": { "type": ["boolean", "null"] },
        "rate_limit_reached_type": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
