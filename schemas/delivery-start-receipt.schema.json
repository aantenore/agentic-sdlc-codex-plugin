{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-start-receipt.schema.json",
  "title": "Exact delivery start receipt",
  "type": "object",
  "required": [
    "id",
    "kind",
    "schema_version",
    "profile_ref",
    "delivery",
    "story_ref",
    "contract_ref",
    "contract_approval_hash",
    "phase",
    "route",
    "autonomy_decision_ref",
    "effective_level",
    "start_basis",
    "status",
    "started_by",
    "started_at",
    "audit",
    "receipt_hash",
    "hash_algorithm"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "const": "delivery_start_receipt" },
    "schema_version": {
      "enum": [
        "delivery-start-receipt:v1",
        "delivery-start-receipt:v2"
      ]
    },
    "profile_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
    "delivery": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["pull_request", "local_release"] }
      },
      "additionalProperties": false
    },
    "story_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
    "contract_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
    "contract_approval_hash": { "$ref": "#/$defs/sha256" },
    "phase": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "route": { "type": "string", "minLength": 1 },
    "autonomy_decision_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
    "effective_level": { "enum": ["supervised", "checkpointed", "bounded-autonomous"] },
    "start_basis": { "enum": ["explicit-confirmation", "checkpointed-profile", "bounded-autonomous-profile"] },
    "status": { "const": "started" },
    "started_by": { "$ref": "common.schema.json#/$defs/actor" },
    "started_at": { "type": "string", "format": "date-time" },
    "local_release_target_baseline": { "$ref": "#/$defs/local_release_target_snapshot" },
    "audit": { "$ref": "common.schema.json#/$defs/audit" },
    "receipt_hash": { "$ref": "#/$defs/sha256" },
    "hash_algorithm": { "const": "sha256:stable-json:v1" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": { "const": "delivery-start-receipt:v2" }
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["local_release_target_baseline"],
        "properties": {
          "delivery": {
            "type": "object",
            "required": ["id", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "local_release" }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path_hashed_id_ref": {
      "type": "object",
      "required": ["id", "path", "hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "local_release_target_snapshot": {
      "type": "object",
      "required": [
        "schema_version",
        "purpose",
        "profile_ref",
        "workspace_real_path",
        "target_root",
        "allowed_write_paths",
        "entries",
        "observed_at",
        "snapshot_hash",
        "hash_algorithm"
      ],
      "properties": {
        "schema_version": { "const": "local-release-target-snapshot:v1" },
        "purpose": { "enum": ["task_start", "build_authorization", "build_completion"] },
        "profile_ref": {
          "type": "object",
          "required": ["id", "hash"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "hash": { "$ref": "#/$defs/sha256" }
          },
          "additionalProperties": false
        },
        "workspace_real_path": { "type": "string", "minLength": 1 },
        "target_root": { "type": "string", "minLength": 1 },
        "allowed_write_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "entries": {
          "type": "array",
          "minItems": 2,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["path", "status"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "status": { "const": "absent" }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["path", "status", "real_path", "device", "inode"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "status": { "const": "directory" },
                  "real_path": { "type": "string", "minLength": 1 },
                  "device": { "type": "string" },
                  "inode": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "observed_at": { "type": "string", "format": "date-time" },
        "snapshot_hash": { "$ref": "#/$defs/sha256" },
        "hash_algorithm": { "const": "sha256:stable-json:v1" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
