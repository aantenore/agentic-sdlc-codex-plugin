{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-action-attempt-receipt.schema.json",
  "title": "Write-ahead local release action attempt receipt",
  "type": "object",
  "required": [
    "id",
    "kind",
    "schema_version",
    "profile_ref",
    "delivery",
    "action",
    "authorization_receipt_ref",
    "completion_request",
    "smoke_execution_policy_ref",
    "artifact_before_smoke",
    "started_at",
    "receipt_hash",
    "hash_algorithm"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "const": "delivery_action_attempt_receipt" },
    "schema_version": { "const": "delivery-action-attempt-receipt:v1" },
    "profile_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
    "delivery": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "local_release" }
      },
      "additionalProperties": false
    },
    "action": { "const": "release.local" },
    "authorization_receipt_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
    "completion_request": {
      "type": "object",
      "required": [
        "schema_version",
        "profile_ref",
        "action",
        "outcome",
        "authorization_receipt_ref",
        "evidence",
        "operation_args",
        "request_hash",
        "hash_algorithm"
      ],
      "properties": {
        "schema_version": { "const": "delivery-action-completion-request:v1" },
        "profile_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
        "action": { "const": "release.local" },
        "outcome": { "const": "passed" },
        "authorization_receipt_ref": { "$ref": "#/$defs/path_hashed_id_ref" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/path_hash" }
        },
        "operation_args": {
          "type": "object",
          "required": ["smoke_cwd", "smoke_tests", "rollback"],
          "properties": {
            "scope_paths": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "remote": { "const": null },
            "pr_url": { "const": null },
            "expected_pr_title": { "const": null },
            "expected_pr_body_sha256": { "const": null },
            "expected_pr_state": { "const": null },
            "expected_pr_base": { "const": null },
            "smoke_cwd": { "type": ["string", "null"], "minLength": 1 },
            "smoke_tests": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 2, "pattern": "^\\[.*\\]$" }
            },
            "rollback": { "type": ["string", "null"], "minLength": 1 }
          },
          "additionalProperties": false
        },
        "request_hash": { "$ref": "#/$defs/sha256" },
        "hash_algorithm": { "const": "sha256:stable-json:v1" }
      },
      "additionalProperties": false
    },
    "smoke_execution_policy_ref": {
      "type": "object",
      "required": ["policy_hash"],
      "properties": {
        "policy_hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "artifact_before_smoke": {
      "type": "object",
      "required": [
        "schema_version",
        "policy",
        "root_identity",
        "paths",
        "manifest_hash",
        "hash_algorithm"
      ],
      "properties": {
        "schema_version": { "const": "local-release-artifact-manifest:v1" },
        "policy": {
          "type": "object",
          "required": ["policy_hash"],
          "properties": {
            "policy_hash": { "$ref": "#/$defs/sha256" }
          }
        },
        "root_identity": { "type": "object" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object" }
        },
        "manifest_hash": { "$ref": "#/$defs/sha256" },
        "hash_algorithm": { "const": "sha256:stable-json:v1" }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "receipt_hash": { "$ref": "#/$defs/sha256" },
    "hash_algorithm": { "const": "sha256:stable-json:v1" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path_hash": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "path_hashed_id_ref": {
      "type": "object",
      "required": ["id", "path", "hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
