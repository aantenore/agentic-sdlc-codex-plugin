{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-strict-gate-receipt.schema.json",
  "title": "Governed intermediate strict story gate receipt",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "status",
    "strict",
    "scope",
    "lifecycle_complete",
    "certification_level",
    "story_id",
    "checked_at",
    "errors",
    "strict_receipt_path",
    "hash_algorithm",
    "receipt_hash"
  ],
  "properties": {
    "kind": { "const": "workflow_strict_gate_receipt" },
    "schema_version": { "const": "workflow-strict-gate-receipt:v1" },
    "status": { "const": "passed" },
    "strict": { "const": true },
    "scope": { "const": "story" },
    "lifecycle_complete": { "const": false },
    "certification_level": { "const": "strict_intermediate" },
    "story_id": { "type": "string", "minLength": 1 },
    "checked_at": { "type": "string", "format": "date-time" },
    "errors": {
      "type": "array",
      "maxItems": 0
    },
    "strict_receipt_path": {
      "type": "string",
      "pattern": "^\\.sdlc/gates/[A-Za-z0-9._-]+-strict\\.json$"
    },
    "hash_algorithm": { "const": "sha256:stable-json:v1" },
    "receipt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
