{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-canonical-evidence.schema.json",
  "title": "Canonical workflow lifecycle evidence snapshot",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "instance_id",
    "story_id",
    "observed_at",
    "checks",
    "hash_algorithm",
    "evidence_hash"
  ],
  "properties": {
    "kind": { "const": "workflow_canonical_evidence" },
    "schema_version": {
      "enum": [
        "workflow-canonical-evidence:v1",
        "workflow-canonical-evidence:v2"
      ]
    },
    "instance_id": { "type": "string", "minLength": 1 },
    "story_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "output_scope": {
      "$ref": "#/$defs/output_scope"
    },
    "workflow_scope": {
      "oneOf": [
        { "$ref": "#/$defs/workflow_scope" },
        { "type": "null" }
      ]
    },
    "checks": {
      "type": "object",
      "required": [
        "requirement_approved",
        "contract_approved",
        "required_output_linked",
        "strict_gate_passed",
        "delivery_terminal"
      ],
      "properties": {
        "requirement_approved": { "$ref": "#/$defs/check" },
        "contract_approved": { "$ref": "#/$defs/check" },
        "required_output_linked": { "$ref": "#/$defs/check" },
        "strict_gate_passed": { "$ref": "#/$defs/check" },
        "delivery_terminal": { "$ref": "#/$defs/check" }
      },
      "additionalProperties": false
    },
    "hash_algorithm": { "const": "sha256:stable-json:v1" },
    "evidence_hash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "workflow-canonical-evidence:v2"
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["output_scope", "workflow_scope"],
        "properties": {
          "workflow_scope": {
            "$ref": "#/$defs/workflow_scope"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "workflow-canonical-evidence:v1"
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["output_scope"] },
            { "required": ["workflow_scope"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "required": ["satisfied", "issues"],
      "properties": {
        "satisfied": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_scope": {
      "type": "object",
      "required": ["current_phase", "phase_order", "require_all"],
      "properties": {
        "current_phase": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "phase_order": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "require_all": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "workflow_scope": {
      "type": "object",
      "required": [
        "instance_id",
        "instance_hash",
        "effective_hash",
        "story_id",
        "current_phase",
        "phase_order",
        "checkpoint_ref"
      ],
      "properties": {
        "instance_id": { "type": "string", "minLength": 1 },
        "instance_hash": { "$ref": "#/$defs/hash" },
        "effective_hash": { "$ref": "#/$defs/hash" },
        "story_id": { "type": "string", "minLength": 1 },
        "current_phase": { "type": "string", "minLength": 1 },
        "phase_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "checkpoint_ref": {
          "type": "object",
          "required": [
            "checkpoint_hash",
            "sequence",
            "last_event_hash",
            "trace_chain_hash",
            "updated_at"
          ],
          "properties": {
            "checkpoint_hash": {
              "oneOf": [
                { "$ref": "#/$defs/hash" },
                { "type": "null" }
              ]
            },
            "sequence": { "type": "integer", "minimum": 0 },
            "last_event_hash": {
              "oneOf": [
                { "$ref": "#/$defs/hash" },
                { "type": "null" }
              ]
            },
            "trace_chain_hash": {
              "oneOf": [
                { "$ref": "#/$defs/hash" },
                { "type": "null" }
              ]
            },
            "updated_at": { "type": "string", "format": "date-time" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "sequence": { "const": 0 } },
                "required": ["sequence"]
              },
              "then": {
                "properties": { "last_event_hash": { "type": "null" } }
              },
              "else": {
                "properties": { "last_event_hash": { "$ref": "#/$defs/hash" } }
              }
            },
            {
              "if": {
                "properties": { "checkpoint_hash": { "type": "null" } },
                "required": ["checkpoint_hash"]
              },
              "then": {
                "properties": { "trace_chain_hash": { "type": "null" } }
              },
              "else": {
                "properties": { "trace_chain_hash": { "$ref": "#/$defs/hash" } }
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
