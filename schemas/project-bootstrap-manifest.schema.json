{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-bootstrap-manifest.schema.json",
  "title": "Agentic SDLC Project Bootstrap Manifest v1",
  "description": "Immutable final record proving that the initial project bootstrap completed before the knowledge base was opened for normal evolution.",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "version",
    "status",
    "plugin_version",
    "project_binding_sha256",
    "initial_config",
    "phase_order",
    "kb_directories",
    "directories",
    "artifacts",
    "completed_at",
    "audit",
    "hash_algorithm",
    "manifest_hash"
  ],
  "properties": {
    "kind": { "const": "project_bootstrap_manifest" },
    "schema_version": { "const": "project-bootstrap-manifest:v1" },
    "version": { "const": 1 },
    "status": { "const": "completed" },
    "plugin_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "project_binding_sha256": { "$ref": "#/$defs/sha256" },
    "bootstrap_journal": {
      "type": "object",
      "required": [
        "path",
        "schema_version",
        "request_hash"
      ],
      "properties": {
        "path": { "const": ".sdlc/bootstrap-journal.json" },
        "schema_version": { "const": "project-bootstrap-journal:v1" },
        "request_hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "initial_config": {
      "type": "object",
      "required": [
        "path",
        "initial_content_sha256",
        "lock_path",
        "initial_lock_content_sha256",
        "lock_hash"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/project_path" },
        "initial_content_sha256": { "$ref": "#/$defs/sha256" },
        "lock_path": { "$ref": "#/$defs/project_path" },
        "initial_lock_content_sha256": { "$ref": "#/$defs/sha256" },
        "lock_hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "phase_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "kb_directories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
      }
    },
    "directories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/project_path" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "completed_at": { "type": "string", "format": "date-time" },
    "audit": {
      "type": "object",
      "required": ["actor"],
      "properties": {
        "actor": { "$ref": "common.schema.json#/$defs/actor" }
      },
      "additionalProperties": false
    },
    "hash_algorithm": { "const": "sha256:stable-json:v1" },
    "manifest_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "project_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\.sdlc(?:/(?!\\.\\.?/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+)?$"
    },
    "artifact": {
      "type": "object",
      "required": ["role", "path", "initial_content_sha256"],
      "properties": {
        "role": {
          "enum": [
            "project",
            "config",
            "config_lock",
            "readme",
            "git_attributes",
            "git_ignore",
            "output_contract_registry",
            "dependency_graph",
            "phase_contract"
          ]
        },
        "path": { "$ref": "#/$defs/project_path" },
        "initial_content_sha256": { "$ref": "#/$defs/sha256" },
        "id": { "type": "string", "minLength": 1 },
        "phase": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
